# Copy to .env (never commit .env). Used by docker-compose.prod.yml; the same names work for a local backend.

# REQUIRED in production: signs login tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=

# Browser origins allowed to call the API, comma separated. Leave "*" only for local development.
CORS_ORIGINS=https://truthlens.example.com

# Host port the site is published on, and the address it listens on. Behind a TLS reverse proxy on the same machine use
# BIND_ADDRESS=127.0.0.1 so the plain-HTTP site is reachable only through the proxy.
PUBLIC_PORT=80
BIND_ADDRESS=0.0.0.0

# Optional tuning
MAX_FILE_SIZE_MB=100
DETECTION_JOB_CONCURRENCY=1
# VIDEO_MODEL_BACKEND=model_v1
